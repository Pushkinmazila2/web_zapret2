# web_zapret2 — nfqws/firewall defaults (sourced by the wz-* scripts)
# Values are overridable from the container environment.

# mark nfqws sets on re-injected packets to prevent loop
DESYNC_MARK=0x40000000

# Keep upstream blockcheckw's fixed NFQUEUE 200 free.
QNUM_TCP=${QNUM_TCP:-210}
QNUM_UDP=${QNUM_UDP:-211}
QNUM_TEST=${QNUM_TEST:-212}

# destination ports handed to nfqws for desync (direct mode)
NFQ_TCP_PORTS=${NFQ_TCP_PORTS:-80,443}
NFQ_UDP_PORTS=${NFQ_UDP_PORTS:-443}

# desync only the first N packets of each flow (CPU guard)
NFQWS_TCP_PKT_OUT=${NFQWS_TCP_PKT_OUT:-9}
NFQWS_UDP_PKT_OUT=${NFQWS_UDP_PKT_OUT:-9}

# local exit-layer ports redsocks listens on / ss-local listens on
REDSOCKS_PORT=1060
SS_LOCAL_PORT=1090

# fwmark used to route access-layer UDP into the utun relay (upstream modes)
UDP_MARK=0x1
UTUN=utun0

# routing table used for the marked UDP path
RT_TABLE_UDP=100