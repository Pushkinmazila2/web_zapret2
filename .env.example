# =============================================================================
# web_zapret2 — Stage 1 gateway configuration
# Copy to .env and adjust. NEVER commit .env.
# =============================================================================

# --- Access layer: Shadowsocks server (listens inside the container) ---------
# Published host port for SS TCP and UDP. Internal fixed port is 8388.
SS_LISTEN_PORT=8388
SS_PASSWORD=change-me-strong-password
SS_METHOD=aes-256-gcm

# --- Access layer: SOCKS5 server (dante) --------------------------------------
# Published host port for SOCKS5 TCP and UDP. Internal fixed port is 1080.
SOCKS5_LISTEN_PORT=1080

# --- Web panel ----------------------------------------------------------------
# Published host port for the HTML panel. Internal fixed port is 8080.
PANEL_PORT=8080
# Optional HTTP Basic auth. Leave both empty for no auth (LAN use only!).
PANEL_USER=
PANEL_PASSWORD=

# Public address clients use to reach Shadowsocks/SOCKS5 (shown in the panel).
# Empty = auto-detect via a public-IP echo service (fallback: local/bridge IP).
PUBLIC_HOST=

# --- Exit layer (where the gateway sends processed traffic) --------------------
# direct  - straight to the internet via the container default route
# socks5  - via an upstream SOCKS5 proxy
# ss      - via an upstream Shadowsocks server
EXIT_MODE=direct

# Upstream SOCKS5 (used when EXIT_MODE=socks5)
UPSTREAM_SOCKS5_HOST=
UPSTREAM_SOCKS5_PORT=
UPSTREAM_SOCKS5_USER=
UPSTREAM_SOCKS5_PASSWORD=

# Upstream Shadowsocks (used when EXIT_MODE=ss)
UPSTREAM_SS_HOST=
UPSTREAM_SS_PORT=8388
UPSTREAM_SS_PASSWORD=
UPSTREAM_SS_METHOD=aes-256-gcm

# UDP in upstream modes:
# relay  - full UDP support via local SOCKS5 UDP-ASSOCIATE relay (default)
# direct - UDP exits the container directly (TCP still goes upstream)
UDP_PROXY=relay

# --- zapret2 / nfqws ----------------------------------------------------------
# Strategy id from config/strategies.json (applied on every start; can be
# changed live from the web panel).
STRATEGY=standard
# Destination ports handed to nfqws for desync.
NFQ_TCP_PORTS=80,443
NFQ_UDP_PORTS=443
# Desync first N packets of a flow only (CPU guard), keep in line with zapret.
NFQWS_TCP_PKT_OUT=9
NFQWS_UDP_PKT_OUT=9

# --- Strategy testing (panel Test tab / API) ---------------------------------
# URL probed with yt-dlp through an ISOLATED test nfqws process (its own
# NFQUEUE queue) — the live nfqws / active strategy is never touched.
# Override per request from the Test tab or via POST /api/strategy/test.
TEST_YTDLP_URL=https://www.youtube.com/watch?v=kJQP7kiw5Fk&list=RDkJQP7kiw5Fk&start_radio=1&pp=ygUKZGVzcGFjaXRvIKAHAQ%3D%3D
# Hard wall-clock timeout for one yt-dlp probe (10-600 s).
TEST_YTDLP_TIMEOUT=120
# Smallest format is probed first (fast, cheap); "worst" -> "b" fallback.
TEST_YTDLP_FORMAT=worst/b
# Refuse anything bigger than this (protects against huge downloads).
TEST_YTDLP_MAX_FILESIZE=80M

# --- Miscellaneous ------------------------------------------------------------
# WAN interface used as the container egress (usually eth0 or eth1).
WAN_IFACE=eth0
TZ=UTC